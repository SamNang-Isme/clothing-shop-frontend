{
  "version": 2,
  "buildCommand": "npm run build && mkdir -p dist && cp -r public/build dist/build && cp -r public/assets dist/assets && cp -r vercel-storage dist/storage && cp -f public/favicon.ico public/robots.txt dist/",
  "outputDirectory": "dist",
  "functions": {
    "api/index.php": {
        "runtime": "vercel-php@0.7.4",
        "excludeFiles": "{dist/**,public/assets/**,public/build/**,vercel-storage/**,database/database.sqlite,.git/**}"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_PACKAGES_CACHE": "/tmp/packages.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "APP_SERVICES_CACHE": "/tmp/services.php",
    "VIEW_COMPILED_PATH": "/tmp/views",
    "CACHE_STORE": "array",
    "SESSION_DRIVER": "cookie",
    "LOG_CHANNEL": "stderr"
  }
}